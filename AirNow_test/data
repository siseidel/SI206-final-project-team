def city_data(file):
    with open(file) as file:
        file = file.readlines()
    cityList = []
    for i in range(len(file)):
        if i == 0:
            continue
        line = file[i].split(',')
        city_name = line[0].strip('"')
        state = line[2].strip('"')
        zip_code = line[15].strip('"')
        zip_code = zip_code.split()[0]
        cityList.append((city_name, state, zip_code))
        if len(cityList) == 150:
            break
    print(cityList)
    print(len(cityList))
    return cityList

